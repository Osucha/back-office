{
  "realm": "bo-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [ { "name": "architects", "path": "/architects" } ],
  "clients": [
    {
      "clientId": "back-office",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "test-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [ "*" ],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "*" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ada",
      "email": "ada@example.com",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "groups": [ "/architects" ],
      "credentials": [ { "type": "password", "value": "ada-password", "temporary": false } ]
    },
    {
      "username": "stranger",
      "email": "stranger@elsewhere.org",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Stranger",
      "enabled": true,
      "credentials": [ { "type": "password", "value": "stranger-password", "temporary": false } ]
    }
  ]
}

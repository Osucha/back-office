{
  "name": "back-office-web",
  "version": "0.1.0",
  "description": "Back Office web UI (Angular 21 + NG-ZORRO)",
  "scripts": {
    "ng": "ng",
    "start": "npm run manual:link && npm run i18n:merge && ng serve --proxy-config proxy.conf.json",
    "build": "npm run manual:link && npm run i18n:merge && npm run lint:deps && npm run i18n:check && ng build && npm run check:bundle",
    "build:dev": "npm run manual:link && npm run i18n:merge && ng build --configuration development",
    "watch": "npm run manual:link && npm run i18n:merge && ng build --watch --configuration development",
    "test": "npm run manual:link && npm run i18n:merge && ng test",
    "test:ci": "npm run manual:link && npm run i18n:merge && npm run test:scripts && ng test --watch=false --coverage",
    "api:types": "openapi-typescript ../docs/api/openapi.yaml -o src/app/core/api/schema.d.ts --alphabetize && prettier --write src/app/core/api/schema.d.ts",
    "lint:format": "prettier --check \"src/**/*.{ts,html,less}\"",
    "format": "prettier --write \"src/**/*.{ts,html,less}\"",
    "e2e:smoke": "node e2e/smoke.mjs",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "e2e:access": "node e2e/access-check.mjs",
    "check:contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-contrast.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "manual:link": "node scripts/link-manual.mjs",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "i18n:merge": "node scripts/i18n-merge.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/localize": "^21.2.24",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ant-design/icons-angular": "^21.0.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.2.0",
    "echarts": "^6.0.0",
    "marked": "^18.0.0",
    "ng-zorro-antd": "^21.3.3",
    "ngx-echarts": "^21.0.0",
    "ngx-vflow": "^2.7.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^28.0.0",
    "less": "^4.2.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}

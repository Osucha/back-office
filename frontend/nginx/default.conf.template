# Rendered by the nginx image entrypoint with envsubst into /etc/nginx/conf.d/default.conf.
# Variables: ${API_UPSTREAM} (default http://back-office-api:8080), ${NGINX_PORT} (default 8080).
#
# The upstream is resolved once at startup: in Kubernetes the API Service DNS name exists as soon as
# the Service does, in docker-compose use depends_on so the api container name resolves.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Behind an ingress that terminates TLS, keep the original scheme/host so the backend (OIDC BFF)
# builds correct redirect URIs (Spring: server.forward-headers-strategy=framework).
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}
map $http_x_forwarded_host $fwd_host {
    default $http_x_forwarded_host;
    ''      $http_host;
}

server {
    listen       ${NGINX_PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    server_tokens off;

    # --- security headers (server level; locations that add their own headers repeat them) ----
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Angular emits inline styles for view encapsulation and NG-ZORRO sets style attributes,
    # hence 'unsafe-inline' for styles only. Scripts are hashed bundles served from self.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    # --- compression -----------------------------------------------------------------------
    gzip              on;
    gzip_vary         on;
    gzip_comp_level   5;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/markdown text/css application/javascript application/json application/xml image/svg+xml font/woff2;

    # --- health ----------------------------------------------------------------------------
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # --- API proxy --------------------------------------------------------------------------
    # SSE endpoint: no buffering, long read timeout, connection kept open.
    location = /api/v1/events {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
        proxy_set_header   X-Forwarded-Host  $fwd_host;
        proxy_set_header   Connection        "";
        proxy_set_header   Cache-Control     "no-cache";
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        chunked_transfer_encoding on;
        add_header X-Accel-Buffering "no" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /api/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
        proxy_set_header   X-Forwarded-Host  $fwd_host;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_read_timeout 300s;
        client_max_body_size 20m;
    }

    # --- OIDC login through the backend (BFF) -------------------------------------------------
    # /oauth2/authorization/{id} starts the login, /login/oauth2/code/{id} is the redirect URI
    # registered at the identity provider, /logout is Spring Security's logout endpoint.
    # /login itself is the Angular sign-in page and stays in the SPA (location / below).
    location /oauth2/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
        proxy_set_header   X-Forwarded-Host  $fwd_host;
        add_header Cache-Control "no-store" always;
    }
    location /login/oauth2/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
        proxy_set_header   X-Forwarded-Host  $fwd_host;
        add_header Cache-Control "no-store" always;
    }
    location = /logout {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
        proxy_set_header   X-Forwarded-Host  $fwd_host;
    }
    # The CI client script outside the API prefix. Only this file: /ci/<id> is an SPA route.
    location = /ci/backoffice-ci.sh {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
        proxy_set_header   X-Forwarded-Host  $fwd_host;
    }

    # MCP server (ADR 0025): Streamable HTTP may answer with an SSE stream, so no buffering.
    location /mcp {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
        proxy_set_header   X-Forwarded-Host  $fwd_host;
        proxy_set_header   Connection        "";
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 1h;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    # Public attestation keys for offline verification of provenance (docs/guides/provenance.md).
    location /.well-known/back-office/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
        proxy_set_header   X-Forwarded-Host  $fwd_host;
    }
    # Presigned links of the filesystem BlobStore (single-replica installs without S3).
    location /blobs/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
        proxy_set_header   X-Forwarded-Host  $fwd_host;
        proxy_request_buffering off;
        client_max_body_size 512m;
    }

    # Swagger UI and the generated OpenAPI document served by the backend (springdoc).
    location /v3/api-docs {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-Host $fwd_host;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
    }
    location /swagger-ui {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-Host $fwd_host;
        proxy_set_header   X-Forwarded-Proto $fwd_proto;
        # Swagger UI ships inline scripts; relax CSP only here.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # --- the user manual (in-app help): never the SPA fallback, revalidated on every use ----
    location ^~ /manual/ {
        try_files $uri =404;
        types {
            text/markdown    md;
            application/json json;
            image/png        png;
            image/svg+xml    svg;
            image/webp       webp;
            image/jpeg       jpg jpeg;
        }
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; frame-ancestors 'none'" always;
    }

    # --- UI translations (ADR 0026): fetched by main.ts at start-up, not hashed, so revalidated -
    location ^~ /i18n/ {
        try_files $uri =404;
        types {
            application/json json;
        }
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # --- static assets: hashed bundles are immutable ---------------------------------------
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|jpeg|gif|ico|webp)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # --- SPA: history API fallback; never cache the shell ---------------------------------
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    }
}

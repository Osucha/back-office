{{/* =========================================================================================
Shared pod building blocks of the backend roles (api, worker, api,worker, migrate). One image,
the role is selected by BACKOFFICE_ROLE (ADR 0023). Usage:
  include "back-office.app.deployment" (dict "root" $ "component" "api" "role" "api" "cfg" .Values.api)
========================================================================================= */}}

{{/* envFrom shared by every long-running role */}}
{{- define "back-office.app.envFrom" -}}
{{- $root := .root -}}
- configMapRef:
    name: {{ include "back-office.config.fullname" $root }}
- secretRef:
    name: {{ include "back-office.appSecretName" $root }}
- secretRef:
    name: {{ include "back-office.providerKeysSecretName" $root }}
    optional: true
- secretRef:
    name: {{ include "back-office.integrationsSecretName" $root }}
    optional: true
{{- with include "back-office.storage.secretName" $root }}
- secretRef:
    name: {{ . }}
{{- end }}
{{- if .signing }}
- secretRef:
    name: {{ include "back-office.signing.secretName" $root }}
    # generated by the signing-key hook Job or created by you (deploy/scripts/gen-signing-key.sh)
    optional: {{ $root.Values.signing.optional }}
{{- end }}
{{- with $root.Values.api.extraEnvFrom }}
{{ toYaml . }}
{{- end }}
{{- end -}}

{{/* env shared by every role (secrets referenced by key, downward API) */}}
{{- define "back-office.app.env" -}}
{{- $root := .root -}}
- name: BACKOFFICE_ROLE
  value: {{ .role | quote }}
- name: POD_NAME
  valueFrom:
    fieldRef:
      fieldPath: metadata.name
- name: POD_NAMESPACE
  valueFrom:
    fieldRef:
      fieldPath: metadata.namespace
- name: SPRING_DATASOURCE_PASSWORD
  valueFrom:
    secretKeyRef:
      name: {{ include "back-office.database.passwordSecretName" $root }}
      key: {{ include "back-office.database.passwordSecretKey" $root }}
{{- with $root.Values.auth.oidc.existingSecret }}
- name: BACKOFFICE_AUTH_OIDC_CLIENT_SECRET
  valueFrom:
    secretKeyRef:
      name: {{ . }}
      key: {{ $root.Values.auth.oidc.existingSecretKey }}
{{- end }}
{{- if and $root.Values.langfuse.enabled $root.Values.langfuseAuth.existingSecret }}
- name: OTEL_EXPORTER_OTLP_HEADERS_AUTHORIZATION
  valueFrom:
    secretKeyRef:
      name: {{ $root.Values.langfuseAuth.existingSecret }}
      key: {{ $root.Values.langfuseAuth.existingSecretKey }}
{{- end }}
{{- if or $root.Values.otel.enabled $root.Values.langfuse.enabled }}
- name: OTEL_SERVICE_NAME
  value: {{ printf "back-office-%s" .component | quote }}
- name: OTEL_RESOURCE_ATTRIBUTES
  value: {{ printf "service.namespace=back-office,deployment.environment=%s,k8s.namespace.name=$(POD_NAMESPACE),k8s.pod.name=$(POD_NAME),backoffice.role=%s" $root.Values.otel.environment .role | quote }}
{{- end }}
{{- with .extraEnv }}
{{ toYaml . }}
{{- end }}
{{- end -}}

{{/* Minimal environment of the migrate role (hook Job and init container) */}}
{{- define "back-office.migrate.env" -}}
{{- $root := .root -}}
- name: BACKOFFICE_ROLE
  value: migrate
- name: SPRING_FLYWAY_ENABLED
  value: "true"
- name: SPRING_DATASOURCE_URL
  value: {{ include "back-office.database.directJdbcUrl" $root | quote }}
- name: SPRING_DATASOURCE_USERNAME
  value: {{ include "back-office.database.username" $root | quote }}
- name: SPRING_DATASOURCE_PASSWORD
  valueFrom:
    secretKeyRef:
      {{- if and .hook (include "back-office.database.inlinePassword" $root) }}
      name: {{ include "back-office.migrate.fullname" $root }}
      key: SPRING_DATASOURCE_PASSWORD
      {{- else }}
      name: {{ include "back-office.database.passwordSecretName" $root }}
      key: {{ include "back-office.database.passwordSecretKey" $root }}
      {{- end }}
- name: LOG_LEVEL
  value: {{ $root.Values.api.config.logLevel | quote }}
- name: JAVA_TOOL_OPTIONS
  value: {{ $root.Values.migration.javaToolOptions | quote }}
{{- with $root.Values.migration.extraEnv }}
{{ toYaml . }}
{{- end }}
{{- end -}}

{{/* Init containers running the migrate role before the app container (migration.initContainer) */}}
{{- define "back-office.migrate.initContainers" -}}
{{- $root := .root -}}
- name: wait-for-db
  image: {{ $root.Values.migration.waitImage | quote }}
  imagePullPolicy: IfNotPresent
  command: ["sh", "-c"]
  args:
    - {{ printf "until pg_isready -h %s -p %s -t 3; do echo waiting for PostgreSQL; sleep 3; done" (include "back-office.database.host" $root) (include "back-office.database.port" $root) | quote }}
  securityContext:
    {{- toYaml $root.Values.api.securityContext | nindent 4 }}
    runAsNonRoot: true
    runAsUser: 70
  resources:
    requests: { cpu: 10m, memory: 16Mi }
    limits: { memory: 64Mi }
- name: migrate
  image: {{ include "back-office.api.image" $root | quote }}
  imagePullPolicy: {{ $root.Values.api.image.pullPolicy }}
  # Flyway takes a PostgreSQL advisory lock: concurrent pods migrate one after the other, the rest no-op.
  env:
    {{- include "back-office.migrate.env" (dict "root" $root "hook" false) | nindent 4 }}
  {{- with $root.Values.api.securityContext }}
  securityContext:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  resources:
    {{- toYaml $root.Values.migration.resources | nindent 4 }}
  volumeMounts:
    - name: tmp
      mountPath: /tmp
{{- end -}}

{{/* Topology spread over zones and nodes (soft) */}}
{{- define "back-office.app.topologySpread" -}}
{{- $root := .root -}}
{{- if $root.Values.topologySpread.enabled }}
topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: topology.kubernetes.io/zone
    whenUnsatisfiable: {{ $root.Values.topologySpread.zoneWhenUnsatisfiable }}
    labelSelector:
      matchLabels:
        {{- include "back-office.selectorLabels" (dict "root" $root "component" .component) | nindent 8 }}
  - maxSkew: 1
    topologyKey: kubernetes.io/hostname
    whenUnsatisfiable: {{ $root.Values.topologySpread.hostWhenUnsatisfiable }}
    labelSelector:
      matchLabels:
        {{- include "back-office.selectorLabels" (dict "root" $root "component" .component) | nindent 8 }}
{{- end }}
{{- end -}}

{{/* Complete Deployment of a long-running role */}}
{{- define "back-office.app.deployment" -}}
{{- $root := .root -}}
{{- $cfg := .cfg -}}
{{- $component := .component -}}
{{- $name := printf "%s-%s" (include "back-office.fullname" $root) $component -}}
{{- $isApi := contains "api" .role -}}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ $name }}
  namespace: {{ $root.Release.Namespace }}
  labels:
    {{- include "back-office.labels" $root | nindent 4 }}
    app.kubernetes.io/component: {{ $component }}
    backoffice.role: {{ .role | replace "," "-" | quote }}
  {{- include "back-office.annotations" $root | nindent 2 }}
spec:
  {{- if not .autoscaled }}
  replicas: {{ $cfg.replicas }}
  {{- end }}
  revisionHistoryLimit: 5
  {{- with $cfg.strategy }}
  strategy:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  selector:
    matchLabels:
      {{- include "back-office.selectorLabels" (dict "root" $root "component" $component) | nindent 6 }}
  template:
    metadata:
      labels:
        {{- include "back-office.selectorLabels" (dict "root" $root "component" $component) | nindent 8 }}
        backoffice.role: {{ .role | replace "," "-" | quote }}
        {{- with $cfg.podLabels }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
      annotations:
        # Roll pods when configuration or inline secrets change.
        checksum/config: {{ include (print $root.Template.BasePath "/configmap-app.yaml") $root | sha256sum }}
        checksum/secret: {{ include (print $root.Template.BasePath "/secret-app.yaml") $root | sha256sum }}
        checksum/provider-keys: {{ include (print $root.Template.BasePath "/secret-provider-keys.yaml") $root | sha256sum }}
        checksum/integrations: {{ include (print $root.Template.BasePath "/secret-integrations.yaml") $root | sha256sum }}
        checksum/storage: {{ include (print $root.Template.BasePath "/secret-storage.yaml") $root | sha256sum }}
        {{- with $cfg.podAnnotations }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
    spec:
      {{- with $root.Values.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      serviceAccountName: {{ include "back-office.api.serviceAccountName" $root }}
      # The control plane never talks to the Kubernetes API (ADR 0024): no token in the pod.
      automountServiceAccountToken: false
      {{- with $cfg.priorityClassName }}
      priorityClassName: {{ . }}
      {{- end }}
      terminationGracePeriodSeconds: {{ $cfg.terminationGracePeriodSeconds }}
      {{- with $root.Values.api.podSecurityContext }}
      securityContext:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- if include "back-office.migration.initContainer" $root }}
      initContainers:
        {{- include "back-office.migrate.initContainers" (dict "root" $root) | nindent 8 }}
      {{- end }}
      containers:
        - name: {{ $component }}
          image: {{ include "back-office.api.image" $root | quote }}
          imagePullPolicy: {{ $root.Values.api.image.pullPolicy }}
          {{- with $root.Values.api.securityContext }}
          securityContext:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          ports:
            - name: http
              containerPort: 8080
              protocol: TCP
          envFrom:
            {{- include "back-office.app.envFrom" (dict "root" $root "signing" true) | nindent 12 }}
          env:
            {{- include "back-office.app.env" (dict "root" $root "role" .role "component" $component "extraEnv" (concat ($root.Values.api.extraEnv | default list) ($cfg.extraEnv | default list))) | nindent 12 }}
          {{- if $cfg.probes.startup.enabled }}
          startupProbe:
            httpGet:
              path: /actuator/health/liveness
              port: http
            periodSeconds: {{ $cfg.probes.startup.periodSeconds }}
            failureThreshold: {{ $cfg.probes.startup.failureThreshold }}
          {{- end }}
          livenessProbe:
            httpGet:
              path: /actuator/health/liveness
              port: http
            periodSeconds: {{ $cfg.probes.liveness.periodSeconds }}
            timeoutSeconds: {{ $cfg.probes.liveness.timeoutSeconds }}
            failureThreshold: {{ $cfg.probes.liveness.failureThreshold }}
          readinessProbe:
            httpGet:
              path: /actuator/health/readiness
              port: http
            periodSeconds: {{ $cfg.probes.readiness.periodSeconds }}
            timeoutSeconds: {{ $cfg.probes.readiness.timeoutSeconds }}
            failureThreshold: {{ $cfg.probes.readiness.failureThreshold }}
          {{- if and $isApi $cfg.preStopSleepSeconds }}
          lifecycle:
            # Keep serving while the endpoint is removed from Services/ingress, then Spring's graceful
            # shutdown drains HTTP and closes SSE streams with a retry hint.
            preStop:
              exec:
                command: ["sleep", "{{ $cfg.preStopSleepSeconds }}"]
          {{- end }}
          {{- with $cfg.resources }}
          resources:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            {{- if eq $root.Values.storage.type "filesystem" }}
            - name: blobs
              mountPath: {{ $root.Values.storage.filesystem.path }}
            {{- end }}
            {{- with $root.Values.api.extraVolumeMounts }}
            {{- toYaml . | nindent 12 }}
            {{- end }}
      volumes:
        - name: tmp
          emptyDir: {}
        {{- if eq $root.Values.storage.type "filesystem" }}
        - name: blobs
          persistentVolumeClaim:
            claimName: {{ default (printf "%s-blobs" (include "back-office.fullname" $root)) $root.Values.storage.filesystem.existingClaim }}
        {{- end }}
        {{- with $root.Values.api.extraVolumes }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
      {{- include "back-office.app.topologySpread" (dict "root" $root "component" $component) | nindent 6 }}
      {{- with $cfg.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with $cfg.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with $cfg.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
{{- end -}}

{{/* PodDisruptionBudget for a component */}}
{{- define "back-office.app.pdb" -}}
{{- $root := .root -}}
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: {{ printf "%s-%s" (include "back-office.fullname" $root) .component }}
  namespace: {{ $root.Release.Namespace }}
  labels:
    {{- include "back-office.labels" $root | nindent 4 }}
    app.kubernetes.io/component: {{ .component }}
  {{- include "back-office.annotations" $root | nindent 2 }}
spec:
  {{- if .cfg.maxUnavailable }}
  maxUnavailable: {{ .cfg.maxUnavailable }}
  {{- else }}
  minAvailable: {{ .cfg.minAvailable }}
  {{- end }}
  selector:
    matchLabels:
      {{- include "back-office.selectorLabels" (dict "root" $root "component" .component) | nindent 6 }}
{{- end -}}

# Scripts run inside Linux containers and CI images: always LF, also in Windows checkouts (core.autocrlf=true would
# give them CRLF, and "#!/bin/sh\r" fails with "not found").
gradlew text eol=lf
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
runner/with-extra-ca text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Starter benchmark fixtures (ADR 0047): hidden acceptance tests and golden files are compared byte for byte
# in Linux runners.
backend/evaluation-core/src/main/resources/starter/** -text
